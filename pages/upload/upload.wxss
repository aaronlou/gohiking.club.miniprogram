.page {
  padding-bottom: 220rpx;
}

.login-hero {
  padding: 120rpx 60rpx;
  text-align: center;
}

.login-hero h1 {
  font-size: 44rpx;
  margin: 24rpx 0 20rpx;
  color: var(--forest);
}

.login-hero p {
  font-size: 26rpx;
  color: var(--ink-mute);
  line-height: 1.8;
  margin-bottom: 48rpx;
  text-align: center;
}

/* ---------- Gate ---------- */
.gate {
  padding: 56rpx 40rpx;
}

.gate__title {
  font-size: 44rpx;
  margin: 20rpx 0 16rpx;
  color: var(--forest);
}

.gate__desc {
  font-size: 26rpx;
  color: var(--ink-mute);
  line-height: 1.8;
  margin-bottom: 36rpx;
}

.gate__list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.gate-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: var(--paper-light);
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  padding: 28rpx;
}

.gate-item__body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.gate-item__title {
  font-size: 32rpx;
  font-weight: 600;
}

.gate-item__meta {
  font-size: 20rpx;
  color: var(--ink-mute);
}

.gate-item__cta {
  font-size: 22rpx;
  color: var(--signal-deep);
  white-space: nowrap;
}

/* ---------- Compose ---------- */
.compose {
  padding: 40rpx;
}

.compose__activity {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 32rpx;
}

.compose__activity-title {
  font-size: 32rpx;
  font-weight: 600;
  flex: 1;
  min-width: 0;
}

.mode-tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 28rpx;
}

.mode-tab {
  padding: 14rpx 28rpx;
  font-size: 24rpx;
  border: 1rpx solid var(--line-strong);
  border-radius: var(--radius);
  color: var(--ink-mute);
}

.mode-tab.is-active {
  background: var(--ink);
  color: var(--paper);
  border-color: var(--ink);
}

.dropzone {
  border: 2rpx dashed var(--line-strong);
  border-radius: var(--radius);
  background: var(--paper-light);
  min-height: 280rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  padding: 40rpx;
  margin-bottom: 36rpx;
  position: relative;
}

.dropzone__title {
  font-size: 30rpx;
  color: var(--ink-soft);
  font-family: Georgia, "Songti SC", serif;
}

.dropzone__hint {
  font-size: 20rpx;
}

.chosen-grid {
  width: 100%;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.chosen {
  position: relative;
  padding-top: 100%;
}

.chosen__img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  border-radius: var(--radius);
  background: var(--paper-deep);
}

.chosen__index {
  position: absolute;
  left: 8rpx;
  top: 8rpx;
  padding: 2rpx 10rpx;
  background: rgba(27, 33, 26, 0.7);
  color: var(--paper);
  font-size: 18rpx;
}

.chosen__remove {
  position: absolute;
  right: 8rpx;
  top: 8rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(27, 33, 26, 0.7);
  color: var(--paper);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.chosen--add {
  border: 2rpx dashed var(--line-strong);
  border-radius: var(--radius);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: var(--sage);
}

.theme-select {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.theme-option {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 20rpx 24rpx;
  border: 1rpx solid var(--line-strong);
  border-radius: var(--radius);
  font-size: 26rpx;
  color: var(--ink-soft);
  min-height: 84rpx;
  box-sizing: border-box;
}

.theme-option.is-active {
  background: var(--ink);
  color: var(--paper);
  border-color: var(--ink);
}

.theme-option__dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.compose__row {
  display: flex;
  gap: 24rpx;
}

.compose__half {
  flex: 1;
}

.compose__note {
  margin: 12rpx 0 32rpx;
  padding: 24rpx 28rpx;
  background: rgba(71, 88, 71, 0.08);
  border-radius: var(--radius);
}

.compose__note p {
  font-size: 22rpx;
  color: var(--ink-mute);
  margin-top: 8rpx;
  line-height: 1.7;
}

.input-ph {
  color: var(--sage);
}

.picker-view {
  display: flex;
  align-items: center;
}

/* ---------- Working ---------- */
.working {
  padding: 56rpx 40rpx;
}

.working__head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.working__desc {
  font-size: 24rpx;
  color: var(--ink-mute);
  line-height: 1.8;
  margin: 20rpx 0 40rpx;
}

.working-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.working-item {
  display: flex;
  gap: 22rpx;
  background: var(--paper-light);
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  padding: 20rpx;
}

.working-item__img {
  width: 160rpx;
  height: 160rpx;
  flex-shrink: 0;
  background: var(--paper-deep);
}

.working-item__body {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  justify-content: center;
}

.working-item__top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.working-item__bar {
  height: 10rpx;
  background: rgba(27, 33, 26, 0.1);
  border-radius: 2rpx;
  overflow: hidden;
}

.working-item__fill {
  height: 100%;
  background: var(--signal);
  transition: width 0.3s ease;
}

.working-item__error {
  font-size: 22rpx;
  color: var(--danger);
}

/* ---------- Result ---------- */
.result {
  padding: 56rpx 40rpx;
}

.result__head h1 {
  font-size: 40rpx;
  color: var(--forest);
  margin-bottom: 16rpx;
  line-height: 1.4;
}

.result__stats {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 24rpx;
  font-size: 20rpx;
  margin-bottom: 40rpx;
}

.result-card {
  background: var(--paper-light);
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  overflow: hidden;
  margin-bottom: 36rpx;
}

.result-card__imgwrap {
  position: relative;
}

.result-card__img {
  width: 100%;
  display: block;
  background: var(--paper-deep);
}

.stamp {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  transform: rotate(-8deg);
  border: 3rpx solid;
}

.stamp--in {
  border-color: var(--signal);
  color: var(--signal-deep);
  background: rgba(251, 248, 241, 0.88);
}

.stamp--out {
  border-color: var(--ink-mute);
  color: var(--ink-mute);
  background: rgba(251, 248, 241, 0.88);
}

.stamp__label {
  font-size: 22rpx;
  letter-spacing: 0.2em;
}

.stamp__score {
  font-size: 48rpx;
  font-family: Georgia, serif;
  font-weight: 600;
  line-height: 1;
}

.result-card__body {
  padding: 28rpx;
}

.result-card__top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14rpx;
}

.result-card__title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.result-card__verdict {
  font-size: 24rpx;
  color: var(--moss);
  font-weight: 600;
  margin-bottom: 14rpx;
}

.result-card__hint {
  font-weight: 400;
  color: var(--ink-mute);
  margin-left: 10rpx;
}

.result-card__summary {
  font-size: 26rpx;
  line-height: 1.8;
  color: var(--ink-soft);
  font-family: Georgia, "Songti SC", serif;
  margin-bottom: 18rpx;
}

.result-card__list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid var(--line);
}

.result-card__line {
  font-size: 24rpx;
  color: var(--ink-soft);
  line-height: 1.7;
}

.result-card__toggle {
  color: var(--signal-deep);
}

.result-card__note {
  margin-top: 16rpx;
  padding: 20rpx 24rpx;
  background: rgba(167, 58, 37, 0.06);
  border-radius: var(--radius);
}

.result-card__note p {
  font-size: 22rpx;
  color: var(--ink-mute);
  line-height: 1.7;
}

.result-card__actions {
  margin-top: 20rpx;
  display: flex;
  gap: 16rpx;
}

.result__foot {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
