.page {
  padding: 48rpx 40rpx 160rpx;
  padding: 48rpx 40rpx calc(160rpx + env(safe-area-inset-bottom));
}

.head__title {
  font-size: 48rpx;
  color: var(--forest);
  margin: 20rpx 0 16rpx;
}

.head__desc {
  font-size: 26rpx;
  color: var(--ink-mute);
  line-height: 1.8;
  margin-bottom: 40rpx;
}

.form {
  display: flex;
  flex-direction: column;
}

.advanced {
  padding: 28rpx;
  margin: 8rpx 0 36rpx;
  background: var(--paper-light);
  border: 1rpx dashed var(--line-strong);
  border-radius: var(--radius);
}

.picker-view {
  display: flex;
  align-items: center;
}

.ph {
  color: var(--sage);
}

/* 提交按钮吸底，长表单滚动时始终可点 */
.form-submit {
  position: fixed;
  left: 40rpx;
  right: 40rpx;
  bottom: 24rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  z-index: 20;
  box-shadow: 0 8rpx 32rpx rgba(27, 33, 26, 0.14);
}

.form-submit.is-keyboard-hidden {
  visibility: hidden;
}
