.page {
  /* 底部 Dock + 安全区 */
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
}

.login-hero {
  padding: 120rpx 60rpx;
  text-align: center;
}

.login-hero h1 {
  font-size: 48rpx;
  margin: 24rpx 0 20rpx;
  color: var(--forest);
}

.login-hero p {
  font-size: 26rpx;
  color: var(--ink-mute);
  line-height: 1.8;
  margin-bottom: 48rpx;
  text-align: center;
}

.member-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 40rpx 40rpx 32rpx;
  background: var(--paper-deep);
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--forest);
  color: var(--paper);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  font-family: Georgia, serif;
  flex-shrink: 0;
}

.member-card__info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  flex: 1;
  min-width: 0;
}

.member-card__name {
  font-size: 38rpx;
  font-weight: 600;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  padding: 32rpx 24rpx 8rpx;
}

.stats-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stats-cell__num {
  font-size: 44rpx;
  font-family: Georgia, "Songti SC", serif;
  font-weight: 600;
}

.stats-cell__label {
  font-size: 20rpx;
  color: var(--ink-mute);
}

.stats-foot {
  text-align: center;
  padding: 8rpx 0 24rpx;
  font-size: 18rpx;
}

.quick-row {
  display: flex;
  gap: 16rpx;
  padding: 0 40rpx 32rpx;
}

.quick-row .btn {
  flex: 1;
}

.warn-banner {
  margin: 0 40rpx 32rpx;
  padding: 24rpx 28rpx;
  background: rgba(223, 90, 52, 0.08);
  border: 1rpx solid rgba(223, 90, 52, 0.3);
  border-radius: var(--radius);
}

.warn-banner p {
  font-size: 24rpx;
  margin-top: 8rpx;
  color: var(--ink-soft);
}

.chapter-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.chapter-card {
  background: var(--paper-light);
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  padding: 26rpx 28rpx;
}

.chapter-card__head {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.chapter-card__title {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.chapter-card__meta {
  font-size: 20rpx;
  color: var(--ink-mute);
}

.chapter-card__foot {
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid var(--line);
  font-size: 22rpx;
  color: var(--ink-mute);
}

.filter-tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 28rpx;
  flex-wrap: wrap;
}

.filter-tab {
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  color: var(--ink-mute);
  border: 1rpx solid var(--line-strong);
  border-radius: var(--radius);
}

.filter-tab.is-active {
  background: var(--ink);
  color: var(--paper);
  border-color: var(--ink);
}

.photo-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.photo-row {
  display: flex;
  gap: 22rpx;
  background: var(--paper-light);
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  padding: 20rpx;
}

.photo-row__img {
  width: 180rpx;
  height: 180rpx;
  flex-shrink: 0;
  background: var(--paper-deep);
}

.photo-row__body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.photo-row__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.photo-row__score {
  color: var(--moss);
}

.photo-row__score.is-low {
  color: var(--danger);
}

.photo-row__title {
  font-size: 28rpx;
  font-family: Georgia, "Songti SC", serif;
  color: var(--ink);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.photo-row__meta {
  font-size: 20rpx;
  color: var(--ink-mute);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.photo-row__summary {
  font-size: 22rpx;
  color: var(--ink-mute);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.photo-row__actions {
  display: flex;
  gap: 28rpx;
  margin-top: 4rpx;
}

.photo-row__delete {
  color: var(--danger);
}
