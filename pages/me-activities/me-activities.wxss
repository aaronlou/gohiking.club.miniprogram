.page {
  padding: 40rpx 40rpx calc(80rpx + env(safe-area-inset-bottom));
}

.section {
  margin-bottom: 48rpx;
}

.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.section-head h2 {
  font-size: 36rpx;
  font-weight: 600;
  font-family: Georgia, "Songti SC", serif;
}

.quiet-card {
  text-align: center;
  color: var(--ink-mute);
  font-size: 24rpx;
  padding: 40rpx;
}

.request-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 22rpx;
  background: rgba(223, 90, 52, 0.05);
  border: 1rpx solid rgba(223, 90, 52, 0.25);
  border-radius: var(--radius);
  margin-bottom: 16rpx;
}

.request-row__avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--forest);
  color: var(--paper);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-family: Georgia, serif;
  flex-shrink: 0;
}

.request-row__body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.request-row__title {
  font-size: 26rpx;
  color: var(--ink);
}

.request-row__meta {
  font-size: 20rpx;
  color: var(--ink-mute);
}

.request-row__cta {
  font-size: 22rpx;
  color: var(--signal-deep);
  white-space: nowrap;
}

.activity-card {
  background: var(--paper-light);
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  padding: 26rpx 28rpx;
  margin-bottom: 20rpx;
}

.activity-card__head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.activity-card__title {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.activity-card__meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 24rpx;
  font-size: 22rpx;
  color: var(--ink-mute);
}

.activity-card__pending {
  color: var(--signal-deep);
  font-weight: 600;
}

.activity-card__actions {
  display: flex;
  gap: 16rpx;
  margin-top: 18rpx;
}

/* 未登录引导（与 me / upload 页同一套） */
.login-hero {
  padding: 120rpx 60rpx;
  text-align: center;
}

.login-hero h1 {
  font-size: 44rpx;
  margin: 24rpx 0 20rpx;
  color: var(--forest);
}

.login-hero p {
  font-size: 26rpx;
  color: var(--ink-mute);
  line-height: 1.8;
  margin-bottom: 48rpx;
  text-align: center;
}
