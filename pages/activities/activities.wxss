.page {
  padding-bottom: 200rpx;
}

.hero-quiet {
  background: var(--paper-deep);
  padding: 56rpx 0 48rpx;
}

.hero-quiet h1 {
  font-size: 52rpx;
  font-weight: 600;
  margin: 20rpx 0 16rpx;
  color: var(--forest);
}

.hero-quiet__desc {
  font-size: 26rpx;
  color: var(--ink-mute);
  line-height: 1.8;
  margin-bottom: 20rpx;
}

.hero-quiet__stats {
  margin-bottom: 32rpx;
}

.shell-pad {
  padding: 24rpx 40rpx;
}

.banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 24rpx 32rpx;
  border-radius: var(--radius);
  margin-top: 24rpx;
}

.banner--signal {
  background: rgba(223, 90, 52, 0.1);
  border: 1rpx solid rgba(223, 90, 52, 0.3);
}

.banner--plain {
  background: var(--paper-light);
  border: 1rpx dashed var(--line-strong);
  font-size: 24rpx;
  color: var(--ink-mute);
}

.banner p {
  font-size: 26rpx;
  color: var(--ink);
  margin-top: 6rpx;
}

.banner__arrow {
  color: var(--signal-deep);
  font-size: 32rpx;
}

.activity-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.activity-card {
  background: var(--paper-light);
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  padding: 28rpx 30rpx;
}

.activity-card--past {
  opacity: 0.78;
}

.activity-card__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.activity-card__title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 10rpx;
}

.activity-card__summary {
  font-size: 24rpx;
  color: var(--ink-mute);
  margin-bottom: 12rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.activity-card__meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 24rpx;
  font-size: 22rpx;
  color: var(--ink-mute);
}

.activity-card__pending {
  color: var(--signal-deep);
  font-weight: 600;
}

.activity-card__host {
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid var(--line);
}
