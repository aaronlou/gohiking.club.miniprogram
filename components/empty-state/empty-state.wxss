.empty {
  padding: 88rpx 40rpx;
  text-align: center;
}

.empty__mark {
  width: 64rpx;
  height: 4rpx;
  background: #df5a34;
  margin: 0 auto 28rpx;
}

.empty__title {
  font-size: 34rpx;
  font-family: Georgia, "Songti SC", serif;
  color: #1b211a;
  margin-bottom: 12rpx;
}

.empty__desc {
  font-size: 24rpx;
  color: #5f665a;
  margin-bottom: 32rpx;
  line-height: 1.7;
}

.empty__btn {
  margin: 0 auto;
  display: inline-flex;
}
